# BarrioVibe LinkedIn lead scraper — credentials
# Paste your real values after the "=" with no quotes and no spaces.
# This file is gitignored and must never be committed.

# Apify API token. Console -> Settings -> API & Integrations -> Personal API tokens
# Looks like: apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APIFY_TOKEN=apify_api_your_token_here

# Mistral API key. console.mistral.ai -> API Keys
MISTRAL_API_KEY=your_mistral_key_here

# Discord webhook for the channel leads are posted to.
# Channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy URL
# Looks like: https://discord.com/api/webhooks/<id>/<token>
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000/xxx


# ---------------------------------------------------------------------------
# Tuning. Defaults are the values agreed in setup — change only deliberately.
# ---------------------------------------------------------------------------

# Hard ceiling on Apify spend for a single run, in USD. The pipeline checks this
# before every paid call and aborts rather than exceeding it. ~8 days on $8. All 6 niches daily.
DAILY_BUDGET_USD=1.00

# Minimum qualification score (0-100) for a lead to reach Discord.
# 55 is recall-first: it rejects genuine non-fits, not borderline real leads.
SCORE_GATE=55

# Only posts newer than this reach the pipeline. Native Apify filter.
# One of: 1h, 24h, week, month
POSTED_LIMIT=24h

# Mistral model for qualification and DM writing.
MISTRAL_MODEL=mistral-medium-latest

# Set to 1 for a dry run: scrapes and scores as normal but sends nothing to
# Discord and writes nothing to the dedup store. Useful for testing.
DRY_RUN=0
